# ── AWS Bedrock Mantle (GLM-5 AI) ──────────────────────
# Bearer token for authentication
AWS_BEARER_TOKEN_BEDROCK=your_bearer_token_here

# Region (default: us-east-1)
AWS_DEFAULT_REGION=us-east-1

# Available models (comma separated)
AVAILABLE_MODELS=zai.glm-5

# Default model
DEFAULT_MODEL=zai.glm-5

# ── Telegram Bot ───────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# API credentials from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# ── Session saqlash kanali ─────────────────────────────
# Bot admin bo'lgan kanal (sessiyalar shu yerda saqlanadi)
SESSION_CHANNEL_ID=-1003547640478

# ── Admin panel ────────────────────────────────────────
# Admin panelga kirish uchun parol. Bo'sh qoldirilsa, panel API'si
# butunlay bloklanadi (hech kim kira olmaydi). Kuchli parol o'rnating!
ADMIN_PASSWORD=change_me_to_a_strong_password

# ── Ovozli javob (Edge-TTS, Token talab qilmaydi) ──────
# Ixtiyoriy. Foydalanuvchi AI'ga "ovoz bilan yubor / gapir" deganda ishlatiladi.
# Har bir til uchun ovozni almashtirish mumkin (edge-tts --list-voices):
# TTS_VOICE_UZ=uz-UZ-SardorNeural
# TTS_VOICE_RU=ru-RU-DmitryNeural
# TTS_VOICE_EN=en-US-GuyNeural
# Nutq tezligi (masalan +5%, -10%):
# TTS_RATE=+0%
